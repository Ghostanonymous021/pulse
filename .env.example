# Public site URL (SEO / Open Graph / metadataBase)
# NEXT_PUBLIC_SITE_URL=https://pulse.example.com

# Public Supabase keys only in NEXT_PUBLIC_*. Never put service_role in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key

# Optional: new publishable key format (reference)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (migrations, admin scripts) — never expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Optional: Postgres for session list (server only)
# DATABASE_POOLER_URL=postgresql://...
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Verification payment (dev defaults: sim allowed outside production)
# VERIFICATION_ALLOW_SIMULATED=true
# VERIFICATION_AUTO_ACTIVATE=true
# Production: leave unset (sim blocked). To force sim in prod (dangerous):
# VERIFICATION_ALLOW_SIMULATED=true
# VERIFICATION_ALLOW_SIMULATED_PROD=true
# VERIFICATION_AUTO_ACTIVATE=true

# Extra allowed browser origins for CSRF checks (comma-separated)
# ALLOWED_ORIGINS=https://pulse.example.com

# Web Push (real device notifications with sound/vibration).
# Generate your own pair, never reuse an example: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...   (safe to expose)
# VAPID_PRIVATE_KEY=...              (server only — used when sending pushes)
